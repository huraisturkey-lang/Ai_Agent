# Copy this to .env and fill in your values:
# cp .env.template .env

# ── Authentication (REQUIRED - no defaults for security) ──
APP_USERNAME=
APP_PASSWORD=

# ── AWS Configuration (REQUIRED) ──
GLUE_DB_NAME=project_library_db
GLUE_DB_NAMES=project_library_db,project_cars_db
PROJECT_FILES_BUCKET=langchain-YOUR_ACCOUNT_ID-eu-north-1
ATHENA_WORKGROUP=project-text-to-sql
ATHENA_USE_MANAGED_RESULTS=true
AWS_REGION=eu-north-1

# ── Bedrock / LLM Configuration ──
BEDROCK_MODEL=eu.amazon.nova-micro-v1:0
BEDROCK_MAX_RETRIES=4
BEDROCK_RETRY_BASE_DELAY=1.0

# ── Query Safety Limits ──
MAX_RESULT_ROWS=200
MAX_QUESTION_CHARS=1000

# ── HTTP API ──
PORT=8080
API_KEY=
LOG_LEVEL=INFO

# ── Remote API (optional - set to route Streamlit queries through FastAPI) ──
# Only use if running Streamlit outside of the VPC (e.g. locally)
# Inside ECS/VPC, leave empty - Streamlit calls AWS directly via VPC endpoints
# API_URL=http://data-arch-ai-alb-xxx.eu-north-1.elb.amazonaws.com

# ── Secrets Manager (optional) ──
SECRETS_MANAGER_SECRET=

# ── External Connector Secrets (referenced in config/connections/*.yaml) ──
# These are AWS Secrets Manager secret names, NOT values.
# Create them in Secrets Manager before using the respective connector.
# redshift/prod-creds        -> {"username":"...", "password":"..."}
# rds/postgres-creds         -> {"username":"...", "password":"..."}
# cgs-ai-rds-aurora/aurora-credentials -> (auto-created by RDS stack)
# snowflake/prod-creds       -> {"username":"...", "password":"..."}
# databricks/token           -> {"token":"dapi..."}
